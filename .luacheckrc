-- luacheck config: run "luacheck ." from this folder (Lua 5.1, like the WoW client).
-- read_globals lists the WoW API this addon uses; a name not on it is a typo or new API:
-- check it exists on Forever (many legacy globals are gone there: use C_Spell, C_Item, ...).
std = "lua51"
max_line_length = false

ignore = {
	"212", -- unused argument (event handlers, callbacks)
	"432", -- shadowing self in nested methods
}

-- tests/test_session.lua is a stand-in WoW client: it defines the API globals the addon uses
files["tests/test_session.lua"] = { global = false, max_line_length = false }

globals = {
	"LightboundDB",
	"SLASH_LIGHTBOUND1",
	"SLASH_LIGHTBOUND2",
	"SLASH_LIGHTBOUND3",
	"SlashCmdList",
}

